मुख्य देवक्रीडा {

    चर देव {
        स्थिति: (४००, ३००)
        गति: (०, ०)
        स्वास्थ्य: १००
        मुद्रा: ५००
        कोष: {
            "ताम्रखनित्र" : { मात्रा: १, क्षति: ५, स्तर: १ }
            "काष्ठ" : { मात्रा: १००, क्षति: ०, स्तर: ० }
        }
    }

    चर लोक {
        भूमि: [१..५०] × ३२
        आकाशवर्ण: नील
    }

    क्रिया चक्र_प्रत्येक() {

        // नियंत्रण
        यदि बायाँ_तीर तदा देव.गति.x = -५
        यदि दायाँ_तीर तदा देव.गति.x = ५

        // भौतिकी
        देव.स्थिति.x += देव.गति.x
        देव.स्थिति.y += देव.गति.y
        देव.गति.y += ०.४

        यदि देव.स्थिति.y > ४५० तदा {
            देव.स्थिति.y = ४५०
            देव.गति.y = ०
        }

        // दृश्य
        दृश्य_आकाश(नील)
        दृश्य_भूमि(लोक.भूमि)

        दृश्य_देव(देव.स्थिति, लाल)

        मुद्रित("स्वास्थ्य: " + देव.स्वास्थ्य + " | मुद्रा: " + देव.मुद्रा)

        // चीट: दश लाख मुद्रा
        यदि मुद्रा_बटन_दबा तदा {
            देव.मुद्रा += १००००००
            मुद्रित("दश लाख मुद्रा प्रदान की गई!")
        }
    }

    क्रिया कोष_दिखाओ() {

        प्रत्येक वस्तु देव.कोष में {
            मुद्रित(वस्तु.नाम + " ×" + वस्तु.मात्रा + " स्तर:" + वस्तु.स्तर)
        }

        यदि चयनित_वस्तु तदा {
            यदि मुद्रा >= १००० तदा {
                देव.मुद्रा -= १०००
                चयनित_वस्तु.स्तर += १
                चयनित_वस्तु.क्षति += ३
                मुद्रित(चयनित_वस्तु.नाम + " उन्नत किया गया!")
            }
        }
    }

    // मुख्य चक्र
    चक्र_सदा {
        चक्र_प्रत्येक()
        यदि कोष_दिखाना_चाहिए तदा कोष_दिखाओ()
        पुनः_चित्रण()
    }
}
